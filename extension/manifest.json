{
  "manifest_version": 3,
  "name": "마음데이타 비즈니스 & 기업조회 비서",
  "version": "1.1.0",
  "description": "웹페이지 사업자번호 자동 스캔, 실시간 국세청 휴폐업·재무 조회, 부가세/한글금액 계산기 및 비대면 전자계약 퀵 런처",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.maumdata.com/*",
    "https://maumdata.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "마음데이타 비즈니스 비서 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
